#!/bin/sh
set -eu

die() {
  printf 'cowtree：%s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    'Usage: cowtree <branch> [destination] [--herdr | --rex] [--base <ref>]' \
    '  cowtree <branch> --herdr' \
    '  cowtree <branch> --rex' \
    '  cowtree <branch> ../custom-path --herdr' \
    '  cowtree <branch> -- <literal destination>' \
    'Copy the current Git repository with macOS cp -cR, including dirty and ignored files but excluding worktree node_modules directories; activate an existing local branch or create a new branch only in the copy.' \
    '複本擁有獨立的 Git 中繼資料，不是真正共享中繼資料的 git worktree。' \
    '省略目的地時會建立來源的兄弟目錄；相對目的地以目前目錄為基準。' \
    '--base <ref> creates a new branch at any commit-ish <ref>, resolved in the source repository and used literally, and discards uncommitted and untracked non-ignored source changes in the copy.' \
    '--herdr creates and focuses a Herdr workspace at the copy after branch activation; requires HERDR_ENV=1.' \
    '--rex opens and focuses a new Rex tab at the copy in the current session after branch activation; requires REX_SESSION.' \
    'Everything after -- is a literal destination; --herdr, --rex, and --base after -- are not flags.' >&2
  exit 2
}

# 以批次呼叫 cp，避免逐一處理檔案；find 只列出目前層級，不會進入 node_modules。
copy_files() {
  find "$1" -mindepth 1 -prune ! -type d \
    -exec sh -c '
      destination=$1
      shift
      cp -cR "$@" "$destination"
    ' cowtree-copy "$2" {} +
}

copy_contents() {
  for child in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [ -e "$child" ] || [ -L "$child" ] || continue

    if [ -d "$child" ] && [ ! -L "$child" ]; then
      if [ "${child##*/}" = node_modules ]; then
        case "$1" in
          "$git_dir"|"$git_dir"/*) ;;
          *) continue ;;
        esac
      fi
      if [ "$child" -ef "$git_dir/worktrees" ]; then
        continue
      fi
      if [ -f "$child/.git" ] && [ ! -L "$child/.git" ]; then
        case "$1" in
          "$git_dir"|"$git_dir"/*) ;;
          *)
            child_common=$(git -C "$child" rev-parse --git-common-dir 2>/dev/null) || continue
            case "$child_common" in
              /*) ;;
              *) child_common=$child/$child_common ;;
            esac
            if [ "$child_common" -ef "$git_dir" ]; then
              continue
            fi
            ;;
        esac
      fi
      mkdir "$2/${child##*/}" || return 1
      copy_contents "$child" "$2/${child##*/}" || return 1
    fi
  done

  copy_files "$1" "$2"
}

[ "$#" -ge 1 ] || usage

branch=$1
shift

workspace_mode=CopyOnly
destination_kind=DefaultSibling
tail_state=Options
base_ref=
base_pending=

for argument in "$@"; do
  if [ -n "$base_pending" ]; then
    case "$argument" in
      ''|-*) usage ;;
    esac
    base_ref=$argument
    base_pending=
    continue
  fi
  case "$tail_state:$argument" in
    Options:--base)
      [ -z "$base_ref" ] || usage
      base_pending=Pending
      ;;
    Options:--herdr)
      [ "$workspace_mode" = CopyOnly ] || usage
      workspace_mode=FocusedHerdr
      ;;
    Options:--rex)
      [ "$workspace_mode" = CopyOnly ] || usage
      workspace_mode=FocusedRex
      ;;
    Options:--)
      tail_state=Literal
      ;;
    *)
      [ "$destination_kind" = DefaultSibling ] || usage
      destination_kind=Explicit
      requested_destination=$argument
      ;;
  esac
done
[ -z "$base_pending" ] || usage

case "$(uname -s 2>/dev/null || printf '')" in
  Darwin) ;;
  *) die '此腳本需要 macOS 的 cp -cR。' ;;
esac

command -v git >/dev/null 2>&1 || die '找不到 git。'
command -v cp >/dev/null 2>&1 || die '找不到 cp。'

[ -n "$branch" ] || die 'Branch must not be empty.'
case "$branch" in
  -*) die 'Branch must not start with a hyphen.' ;;
esac
if ! git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
   ! git check-ref-format "refs/heads/$branch" >/dev/null 2>&1; then
  die "Invalid branch name: $branch"
fi

if [ -n "${GIT_DIR:-}" ] || [ -n "${GIT_COMMON_DIR:-}" ] || [ -n "${GIT_WORK_TREE:-}" ] || [ -n "${GIT_INDEX_FILE:-}" ]; then
  die 'GIT_DIR, GIT_COMMON_DIR, GIT_WORK_TREE, and GIT_INDEX_FILE environment overrides are not supported.'
fi

if ! repo=$(git rev-parse --show-toplevel 2>/dev/null); then
  die '目前位置不在 Git 工作樹內。'
fi
if ! repo=$(cd "$repo" && pwd -P 2>/dev/null); then
  die '無法解析來源儲存庫路徑。'
fi
case "$repo" in
  *[[:cntrl:]]*) die '來源路徑不可包含控制字元。' ;;
esac

if [ ! -d "$repo/.git" ] || [ -L "$repo/.git" ]; then
  die '不支援 .git 檔案或符號連結形式的 linked worktree。'
fi
if [ -e "$repo/.git/commondir" ] || [ -L "$repo/.git/commondir" ]; then
  die '不支援含 .git/commondir 的共享 Git 目錄。'
fi
if git -C "$repo" config --get-all core.worktree >/dev/null 2>&1; then
  die '不支援設定 core.worktree 的共享 Git 工作樹。'
fi

if ! git_dir=$(git -C "$repo" rev-parse --git-dir 2>/dev/null); then
  die '無法讀取來源 Git 目錄。'
fi
case "$git_dir" in
  /*) ;;
  *) git_dir=$repo/$git_dir ;;
esac
if ! git_dir=$(cd "$git_dir" && pwd -P 2>/dev/null); then
  die '無法解析來源 Git 目錄。'
fi

if ! common_dir=$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null); then
  die '無法讀取來源共享 Git 目錄。'
fi
case "$common_dir" in
  /*) ;;
  *) common_dir=$repo/$common_dir ;;
esac
if ! common_dir=$(cd "$common_dir" && pwd -P 2>/dev/null); then
  die '無法解析來源共享 Git 目錄。'
fi

if ! expected_git_dir=$(cd "$repo/.git" && pwd -P 2>/dev/null); then
  die '無法解析來源 .git 目錄。'
fi
if [ "$git_dir" != "$expected_git_dir" ] || [ "$git_dir" != "$common_dir" ]; then
  die '來源使用共享 Git 目錄；請改用一般儲存庫工作樹。'
fi

if ! git -C "$repo" rev-parse --verify HEAD >/dev/null 2>&1; then
  die '來源儲存庫尚無可建立分支的提交。'
fi

if [ -n "$base_ref" ]; then
  if ! base_object=$(git -C "$repo" rev-parse --verify --quiet "$base_ref") ||
     ! base_commit=$(git -C "$repo" rev-parse --verify --quiet "$base_object^{commit}"); then
    die "Invalid base ref: $base_ref"
  fi
fi

branch_status=0
git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || branch_status=$?
case "$branch_status:${base_ref:+Base}" in
  0:)
    branch_kind=ExistingLocal
    ;;
  0:Base)
    die "Branch already exists locally; --base only creates new branches: $branch"
    ;;
  1:)
    branch_kind=NewLocal
    ;;
  1:Base)
    branch_kind=NewLocalFromBase
    ;;
  *)
    die "Local branch lookup failed: $branch"
    ;;
esac

if ! current_dir=$(pwd -P 2>/dev/null); then
  die '無法解析目前目錄。'
fi
if [ "$destination_kind" = DefaultSibling ]; then
  safe_branch=$(printf '%s' "$branch" | tr '/' '-')
  repo_parent=${repo%/*}
  repo_name=${repo##*/}
  [ -n "$repo_parent" ] || repo_parent=/
  if [ "$repo_parent" = / ]; then
    requested_destination="/$repo_name-$safe_branch"
  else
    requested_destination="$repo_parent/$repo_name-$safe_branch"
  fi
fi
[ -n "$requested_destination" ] || die '目的地不可為空。'
case "$requested_destination" in
  *[[:cntrl:]]*) die '目的地不可包含控制字元。' ;;
esac

case "$requested_destination" in
  /*) destination_path=$requested_destination ;;
  *) destination_path=$current_dir/$requested_destination ;;
esac

if [ -e "$destination_path" ] || [ -L "$destination_path" ]; then
  die "目的地已存在，拒絕覆寫：$destination_path"
fi
destination_name=${destination_path##*/}
destination_parent=${destination_path%/*}
[ -n "$destination_name" ] || die '目的地名稱不可為空。'
if [ "$destination_parent" = "$destination_path" ]; then
  destination_parent=.
fi
[ -d "$destination_parent" ] || die "目的地的父目錄不存在：$destination_parent"
if ! destination_parent=$(cd "$destination_parent" && pwd -P 2>/dev/null); then
  die '無法解析目的地父目錄。'
fi
destination="$destination_parent/$destination_name"

if [ -e "$destination" ] || [ -L "$destination" ]; then
  die "目的地已存在，拒絕覆寫：$destination"
fi
if [ "$repo" = / ]; then
  die "目的地不可位於來源儲存庫內：$destination"
fi
case "$destination/" in
  "$repo/"*) die "目的地不可位於來源儲存庫內：$destination" ;;
esac

if [ "$workspace_mode" = FocusedHerdr ]; then
  [ "${HERDR_ENV:-}" = 1 ] || die 'HERDR_ENV=1 is required for --herdr.'
  command -v herdr >/dev/null 2>&1 || die 'herdr is not available on PATH.'
fi
if [ "$workspace_mode" = FocusedRex ]; then
  [ -n "${REX_SESSION:-}" ] || die 'REX_SESSION is required for --rex.'
  command -v rex >/dev/null 2>&1 || die 'rex is not available on PATH.'
fi

# 先保留目的地避免競速碰撞；失敗時保留部分目錄以免誤刪資料。
if ! mkdir "$destination" 2>/dev/null; then
  die "無法建立目的地，可能已被其他程序建立：$destination"
fi
if ! copy_contents "$repo" "$destination" >/dev/null; then
  die "複製失敗；部分複本可能位於：$destination"
fi

case "$branch_kind" in
  ExistingLocal)
    if ! git -C "$destination" -c core.hooksPath=/dev/null checkout --no-guess --no-overwrite-ignore --no-recurse-submodules "$branch" -- >/dev/null; then
      die "Existing local branch activation failed; copy retained at: $destination"
    fi
    ;;
  NewLocal)
    if ! git -C "$destination" -c core.hooksPath=/dev/null branch -- "$branch" >/dev/null 2>&1; then
      die "New local branch creation failed; copy retained at: $destination"
    fi
    if ! git -C "$destination" -c core.hooksPath=/dev/null symbolic-ref HEAD "refs/heads/$branch" >/dev/null 2>&1; then
      die "Branch HEAD activation failed; copy retained at: $destination"
    fi
    ;;
  NewLocalFromBase)
    if ! git -C "$destination" -c core.hooksPath=/dev/null branch -- "$branch" "$base_commit" >/dev/null; then
      die "New local branch creation failed; copy retained at: $destination"
    fi
    if ! git -C "$destination" clean -ffdq >/dev/null; then
      die "Base cleanup failed; copy retained at: $destination"
    fi
    if ! git -C "$destination" -c core.hooksPath=/dev/null checkout --force --no-recurse-submodules "$branch" -- >/dev/null; then
      die "Base branch activation failed; copy retained at: $destination"
    fi
    ;;
esac

case "$workspace_mode" in
  FocusedHerdr)
    if ! herdr workspace create --cwd "$destination" --label "$destination_name" --focus >/dev/null; then
      die "Herdr workspace creation failed; copy retained at: $destination"
    fi
    ;;
  FocusedRex)
    if ! rex window new -s "$REX_SESSION" "$branch" -c "$destination" >/dev/null; then
      die "Rex tab creation failed; copy retained at: $destination"
    fi
    ;;
esac

printf '%s\n' "$destination"
